# =============================================
# Backend Configuration (Render Environment)
# =============================================
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/finpilot?retryWrites=true&w=majority
JWT_SECRET=your_super_secure_random_jwt_secret_here
JWT_EXPIRES_IN=7d
CSRF_SECRET=your_super_secure_random_csrf_secret_here

# CORS — Set to your Vercel frontend URL
CORS_ORIGIN=https://your-app-name.vercel.app

# AI Insights Configuration (OpenAI API key)
# If empty/missing, the backend automatically falls back to an advanced local rule-based advisor engine!
OPENAI_API_KEY=

# Node Environment
NODE_ENV=production

# =============================================
# Frontend Configuration (Vercel Environment)
# =============================================
# Set this in Vercel dashboard as: VITE_API_URL
# VITE_API_URL=https://your-app-name.onrender.com
