# Backend Configuration
PORT=5000
MONGO_URI=mongodb://localhost:27017/ai_expense_tracker
JWT_SECRET=super_secret_jwt_token_change_in_production
JWT_EXPIRES_IN=7d

# AI Insights Configuration (OpenAI API key)
# If empty/missing, the backend automatically falls back to an advanced local rule-based advisor engine!
OPENAI_API_KEY=

# Node Environment
NODE_ENV=development
